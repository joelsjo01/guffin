#include "options.hpp" 
#include <gtest/gtest.h>

TEST(ParsePositiveSize, Empty) {
  std::size_t value;
  EXPECT_FALSE(parse_positive_size("", value));
  EXPECT_EQ(value, 0);
}

TEST(ParsePositiveSize, Signs) {
  EXPECT_FALSE(parse_positive_size("-1", value)); 
  EXPECT_FALSE(parse_positive_size("1-", value));
  EXPECT_FALSE(parse_positive_size("-123", value));
}

// ... similar tests for whitespace, partial strings, overflow

TEST(ParseFloat, NonFinite) {
  float value;
  EXPECT_FALSE(parse_float("inf", value));
  EXPECT_FALSE(parse_float("-inf", value));
  EXPECT_FALSE(parse_float("nan", value));
}

TEST(ParseFloat, Overflow) {
  float value;
  EXPECT_TRUE(parse_float("1.0e+300", value));
  EXPECT_TRUE(parse_float("1.0e+308", value));
  EXPECT_FALSE(parse_float("1.0e+309", value));
}
```

