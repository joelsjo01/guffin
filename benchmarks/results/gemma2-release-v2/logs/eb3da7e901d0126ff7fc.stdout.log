#include "options.hpp"
#include <gtest/gtest.h>

TEST(ParseHelpers, EmptyInput) {
  std::size_t size;
  std::uint64_t u64;
  float float_val;

  EXPECT_FALSE(parse_positive_size("", size));
  EXPECT_FALSE(parse_u64("", u64));
  EXPECT_FALSE(parse_float("", float_val));
}

TEST(ParseHelpers, Signs) {
  EXPECT_FALSE(parse_positive_size("-1", size));
  EXPECT_FALSE(parse_positive_size("1-", size));
}

TEST(ParseHelpers, Whitespace) {
  EXPECT_TRUE(parse_positive_size("  123 ", size));
  EXPECT_TRUE(parse_positive_size("123  ", size));
  EXPECT_TRUE(parse_positive_size(" 123 ", size));
}

TEST(ParseHelpers, PartialNumeric) {
  EXPECT_FALSE(parse_positive_size("123a", size));
  EXPECT_FALSE(parse_u64("123a", u64));
  EXPECT_FALSE(parse_float("123a", float_val));
}

TEST(ParseHelpers, Overflow) {
  // Check for overflow in `size_t` and `uint64_t`
}

TEST(ParseHelpers, NonFiniteFloat) {
  EXPECT_FALSE(parse_float("inf", float_val));
  EXPECT_FALSE(parse_float("-inf", float_val));
  EXPECT_FALSE(parse_float("nan", float_val));
}

```

**Explanation:**

* Each test case focuses on a specific aspect of input validation, such as empty strings, signs, whitespace, partial numeric strings, overflow, and non-finite floating-point values.
* We use `EXPECT_TRUE` and `EXPECT_FALSE` from the Google Test framework to assert the expected behavior. 
* The output arguments (`size`, `u64`, `float_val`) are not expected to change for invalid input cases. 



